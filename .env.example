# AdaptLearn - Root Environment Template
# Copy this file to .env or backend/.env and adjust values as needed.

PROJECT_NAME=AdaptLearn
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Allowed CORS Origins (JSON array of strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

